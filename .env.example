# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Telegram id пользователей, которым разрешён доступ, через запятую.
# Свой id можно узнать, написав боту: он ответит им, если доступа нет.
ALLOWED_USER_IDS=
# База данных (по умолчанию SQLite-файл в каталоге data/)
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Часовой пояс для новых пользователей
DEFAULT_TIMEZONE=Europe/Moscow
# Веб-интерфейс и мини-приложение. Пусто — выключено.
#   http://localhost:8080      — только браузер на этом компьютере (вход по команде /web)
#   https://bot.example.com    — браузер и мини-приложение в Telegram (нужен HTTPS)
WEB_APP_URL=
# HTTPS на сервере: домен (тот же, что в WEB_APP_URL) и включение контейнера Caddy.
WEB_DOMAIN=
# COMPOSE_PROFILES=web
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
