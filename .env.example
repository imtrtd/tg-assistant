# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Telegram id пользователей, которым разрешён доступ, через запятую.
# Свой id можно узнать, написав боту: он ответит им, если доступа нет.
ALLOWED_USER_IDS=
# Кому присылать сообщения об ошибках бота (Telegram id через запятую). Пусто — никому.
ADMIN_IDS=
# База данных (по умолчанию SQLite-файл в каталоге data/)
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Часовой пояс для новых пользователей
DEFAULT_TIMEZONE=Europe/Moscow
# Веб-интерфейс и мини-приложение. Пусто — выключено.
#   http://localhost:8080      — только браузер на этом компьютере (вход по команде /web)
#   https://bot.example.com    — браузер и мини-приложение в Telegram (нужен HTTPS)
WEB_APP_URL=
# Мини-приложение без своего домена — через бесплатный туннель Cloudflare.
# Docker: раскомментируйте обе строки, WEB_APP_URL оставьте пустым (адрес бот узнает сам).
# Без Docker: запустите `cloudflared tunnel --url http://localhost:8080 --metrics localhost:2000`
#             и укажите WEB_TUNNEL_METRICS_URL=http://localhost:2000
# COMPOSE_PROFILES=tunnel
# WEB_TUNNEL_METRICS_URL=http://cloudflared:2000
# HTTPS на сервере: домен (тот же, что в WEB_APP_URL) и включение контейнера Caddy.
WEB_DOMAIN=
# COMPOSE_PROFILES=web
# Сколько дней хранить архив чатов (Telegram Business). 0 — бессрочно.
ARCHIVE_RETENTION_DAYS=0
# Адрес проверки на healthchecks.io (бесплатно): если бот перестал отвечать — даже когда
# выключены все серверы — healthchecks.io сам напишет вам в Telegram. Пусто — выключено.
HEALTHCHECK_PING_URL=
# Как часто присылать бэкап базы администраторам (ADMIN_IDS) файлом в Telegram, в часах.
# 0 — не присылать.
BACKUP_INTERVAL_HOURS=24
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Публичный поиск (Telethon). Пустые значения — команды /search, /sources, /channel, /watch выключены ---
# api_id и api_hash приложения: https://my.telegram.org → API development tools
API_ID=
API_HASH=
# Строка сессии, не файл. Получить: python -m tg_assistant.research.login
# Синоним: SESSION_STRING. Не коммитьте значение и не кладите *.session в git.
TELEGRAM_SESSION=
# Как часто проверять наблюдения, секунды. Первый проход только запоминает уже существующие посты.
RESEARCH_WATCH_INTERVAL_SECONDS=300
# RESEARCH_SEARCH_LIMIT=20
# RESEARCH_FIND_LIMIT=20
# RESEARCH_CHANNEL_HISTORY_LIMIT=100
# RESEARCH_FLOOD_MAX_WAIT_SECONDS=120
# RESEARCH_FLOOD_RETRIES=5
# RESEARCH_RATE_LIMIT_COMMANDS=8
# RESEARCH_RATE_LIMIT_WINDOW_SECONDS=60
# Токен бота можно задать и как BOT_TOKEN — это синоним TELEGRAM_BOT_TOKEN.

# --- Два экземпляра на общей базе: ПК + облако (docs/failover.md) ---
# DATABASE_URL=postgresql+asyncpg://tga:ПАРОЛЬ@postgres:5432/tga    # облако
# DATABASE_URL=postgresql+asyncpg://tga:ПАРОЛЬ@db-access:5432/tga   # ПК
# NODE_NAME=oracle            # или pc — имя узла в логах и таблице cluster_nodes
# NODE_PRIORITY=0             # ПК: 10 — главный; облако: 0 — работает, пока ПК выключен
# COMPOSE_PROFILES=db         # облако; на ПК — remote-db
# POSTGRES_PASSWORD=          # облако: пароль базы (тот же, что в DATABASE_URL)
# CF_TUNNEL_TOKEN=            # облако: токен туннеля Cloudflare
# DB_HOSTNAME=db.example.com  # ПК: адрес базы в Cloudflare
# CF_ACCESS_CLIENT_ID=        # ПК: сервисный токен Cloudflare Access
# CF_ACCESS_CLIENT_SECRET=
